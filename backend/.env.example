# Copy these into your hosting provider's Environment settings.
# Never commit real values or your real .env file.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_ADMIN_CHAT_ID=replace_with_your_numeric_telegram_user_id
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret
MINI_APP_URL=https://YOUR_USERNAME.github.io/TMSTore/

# Bakong/KHQR merchant settings (use the exact account ID registered for your merchant)
BAKONG_TOKEN=replace_with_bakong_open_api_token
BAKONG_ACCOUNT_ID=yourmerchant@bank
MERCHANT_NAME=TM Store
MERCHANT_CITY=Phnom Penh
PAYMENT_CURRENCY=USD
EXCHANGE_RATE_KHR=4100

# Optional: default to 15 minutes for payment expiry where supported by SDK
PAYMENT_EXPIRY_MINUTES=15
